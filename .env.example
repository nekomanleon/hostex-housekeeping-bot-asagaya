# Hostex login
HOSTEX_USERNAME=your_hostex_email@example.com
HOSTEX_PASSWORD=your_hostex_password

# 企业微信 / WeCom 群机器人 webhook
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY

# 阿佐谷三个房源：会逐个抓取，并且符合条件时同时发送到 WeCom
HOSTEX_CLEANING_TARGET_ROOMS=阿佐谷A,阿佐谷B,阿佐谷C

# 发送规则：2天前、1天前、退房清扫当天都提醒
# 如果你想每天只发当天，把它改成 0
HOSTEX_REMINDER_DAY_DIFFS=2,1,0

# 建议日本时间
HOSTEX_CLEANING_TIMEZONE=Asia/Tokyo
HOSTEX_TODAY_OVERRIDE=
HOSTEX_HEADLESS=true
HOSTEX_DEBUG=false
HOSTEX_PAGE_TIMEOUT_MS=90000
HOSTEX_LOGIN_TIMEOUT_MS=90000
HOSTEX_ROOM_FILTER_WAIT_MS=2500
HOSTEX_SNAPSHOT_ATTEMPTS=3
WECOM_SEND_ATTEMPTS=3
HOSTEX_CLEANING_LOG_DIR=logs/hostex-housekeeping-bot
